<ui:FluentWindow x:Class="VrcTool.PickerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="候选清单" Width="1080" Height="780"
                 MinWidth="920" MinHeight="640"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 KeyDown="Win_KeyDown">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="候选清单 —— 选一个用"
                 ShowMaximize="True" ShowMinimize="True" />

    <Grid Grid.Row="1" Margin="26,6,26,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="150" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="150" />
      </Grid.RowDefinitions>

      <ui:TextBlock Grid.Row="0" Text="每组点一行选中，然后按「确定并写入 hosts」"
                 FontSize="15" FontWeight="SemiBold" Margin="0,4,0,14"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

      <!-- A 组 -->
      <DockPanel Grid.Row="1" Margin="2,0,2,6">
        <ui:TextBlock DockPanel.Dock="Right" Text="延迟越低越好" FontSize="11.5"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        <ui:TextBlock FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                   Text="A 组 · Cloudflare　（api / pipeline / dev-api / vrchat.com / www / mail / creators / docs）" />
      </DockPanel>

      <ui:Card Grid.Row="2" Padding="1">
        <DataGrid x:Name="GridA" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  BorderThickness="0" Background="Transparent"
                  CanUserAddRows="False" CanUserResizeRows="False"
                  CanUserReorderColumns="False" CanUserSortColumns="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  RowHeight="28"
                  FontFamily="Consolas,Microsoft YaHei UI" FontSize="12.5"
                  MouseDoubleClick="GridA_MouseDoubleClick"
                  SelectionChanged="Grid_SelectionChanged">
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
              <Style.Triggers>
                <!-- hosts 里当前生效的那一行：绿色加粗 -->
                <DataTrigger Binding="{Binding InUse}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTextColumn Header="编号" Binding="{Binding N}" Width="54" />
            <DataGridTextColumn Header="IP 地址" Binding="{Binding Ip}" Width="170" />
            <!-- A 组固定看延迟，列头直接写在 XAML 里 -->
            <DataGridTextColumn Header="中位延迟" Binding="{Binding V1}" Width="110" />
            <DataGridTextColumn Header="最小" Binding="{Binding V2}" Width="100" />
            <DataGridTextColumn Header="最大" Binding="{Binding V3}" Width="100" />
            <DataGridTextColumn Header="抖动" Binding="{Binding V4}" Width="100" />
            <DataGridTextColumn Header="成功" Binding="{Binding Ok}" Width="76" />
            <DataGridTextColumn Header="成功率" Binding="{Binding Rate}" Width="80" />
            <DataGridTextColumn Header="说明" Binding="{Binding Note}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </ui:Card>

      <!-- B 组 -->
      <DockPanel Grid.Row="3" Margin="2,18,2,6">
        <ui:TextBlock DockPanel.Dock="Right" Text="下载速度越高越好" FontSize="11.5"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        <ui:TextBlock FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                   Text="B 组 · CloudFront　（files / vrcpm.vrchat.cloud　assets / status.vrchat.com）" />
      </DockPanel>

      <ui:Card Grid.Row="4" Padding="1">
        <DataGrid x:Name="GridB" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  BorderThickness="0" Background="Transparent"
                  CanUserAddRows="False" CanUserResizeRows="False"
                  CanUserReorderColumns="False" CanUserSortColumns="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  RowHeight="28"
                  FontFamily="Consolas,Microsoft YaHei UI" FontSize="12.5"
                  MouseDoubleClick="GridB_MouseDoubleClick"
                  SelectionChanged="Grid_SelectionChanged">
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
              <Style.Triggers>
                <DataTrigger Binding="{Binding InUse}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTextColumn Header="编号" Binding="{Binding N}" Width="54" />
            <DataGridTextColumn Header="IP 地址" Binding="{Binding Ip}" Width="170" />
            <!-- B 组的列头随"有没有测速数据"变，用命名列代替原来的 Columns[2..5] 下标硬编码 -->
            <DataGridTextColumn x:Name="BV1" Header="中位延迟" Binding="{Binding V1}" Width="110" />
            <DataGridTextColumn x:Name="BV2" Header="最小" Binding="{Binding V2}" Width="100" />
            <DataGridTextColumn x:Name="BV3" Header="最大" Binding="{Binding V3}" Width="100" />
            <DataGridTextColumn x:Name="BV4" Header="抖动" Binding="{Binding V4}" Width="100" />
            <DataGridTextColumn Header="成功" Binding="{Binding Ok}" Width="76" />
            <DataGridTextColumn Header="成功率" Binding="{Binding Rate}" Width="80" />
            <DataGridTextColumn Header="说明" Binding="{Binding Note}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </ui:Card>

      <!-- 空状态：没有实测数据时不要留两个空表格给人猜 -->
      <ui:TextBlock x:Name="TxtEmpty" Grid.Row="1" Grid.RowSpan="4"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="470" TextAlignment="Center" TextWrapping="Wrap"
                    FontTypography="Body" LineHeight="23"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Visibility="Collapsed" Text="" />
    </Grid>

    <!-- 底部：已选 + 按钮 -->
    <Border Grid.Row="2" Margin="0,16,0,0" Padding="26,14" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <ui:TextBlock x:Name="TxtSel" FontSize="12.5" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     Text="尚未选择" />
          <ui:TextBlock FontSize="11" Margin="0,3,0,0"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                     Text="提示：双击某一行可直接确定；Esc 取消" />
        </StackPanel>

        <ui:Button x:Name="BtnReload" Grid.Column="1" Content="重新读取" Height="42"
                   Padding="18,0" Margin="12,0,0,0" Click="BtnReload_Click" />

        <ui:Button x:Name="BtnApply" Grid.Column="2" Height="42" Padding="22,0"
                   Margin="12,0,0,0" FontSize="13.5" Appearance="Primary"
                   IsDefault="True" IsEnabled="False" Click="BtnApply_Click">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="CheckmarkCircle24" Margin="0,0,8,0"
                           VerticalAlignment="Center" />
            <ui:TextBlock Text="确定并写入 hosts" VerticalAlignment="Center" />
          </StackPanel>
        </ui:Button>
      </Grid>
    </Border>
  </Grid>
</ui:FluentWindow>
