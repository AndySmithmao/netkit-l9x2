<ui:FluentWindow x:Class="VrcTool.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="VRChat优选工具"
                 Width="1180" Height="780"
                 MinWidth="900" MinHeight="620"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

  <!-- RootScale：界面缩放的挂载点。
       用户的显示器 DPI 各不相同，同样一套 DIP 尺寸在 125%/150% 上会显得过大。
       这里对整个根容器做 LayoutTransform 缩放（字体和布局一起缩），
       这样「界面缩放」这一个开关就能同时解决「窗口太大」和「字太大」。
       具体倍数由设置页的「界面缩放」控制，默认 0.9。 -->
  <Grid x:Name="RootScale">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="VRChat优选工具" />

    <!-- IsPaneToggleVisible=True → 左上角出现汉堡按钮，可收起 / 摊开侧栏 -->
    <ui:NavigationView x:Name="RootNav" Grid.Row="1"
                       PaneDisplayMode="Left"
                       OpenPaneLength="248"
                       CompactPaneLength="48"
                       IsBackButtonVisible="Collapsed"
                       IsPaneToggleVisible="True"
                       IsFooterSeparatorVisible="True"
                       AlwaysShowHeader="False">
      <ui:NavigationView.PaneHeader>
        <!-- x:Name 是给「收起侧栏」用的：48px 宽的窄条塞不下这行字，
             会被裁成「VRCh…」。收起时把它藏掉，只留图标。 -->
        <ui:TextBlock x:Name="TxtPaneHeader" Text="VRChat优选工具" FontWeight="Bold"
                      VerticalAlignment="Center" Margin="0,0,0,4"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
      </ui:NavigationView.PaneHeader>

      <!-- 侧栏底部状态条：以前是 RefreshStatus() 里 new 一个 TextBlock 塞进 PaneFooter，
           字号/边距全写在代码里，和 Fluent 主题脱节。现在声明在 XAML，代码只改文字和颜色。 -->
      <ui:NavigationView.PaneFooter>
        <ui:TextBlock x:Name="TxtSidebar" FontTypography="Caption"
                      TextWrapping="Wrap" LineStackingStrategy="BlockLineHeight" LineHeight="17"
                      Margin="14,6,14,10"
                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                      Text="正在检测服务状态…" />
      </ui:NavigationView.PaneFooter>

      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Content="一键完成" Tag="oneclick" Click="NavItem_Click" FontWeight="SemiBold"
                               Icon="{ui:SymbolIcon Play24}" />

        <!-- 分组：加粗，可折叠，默认展开；点一下收起，再点摊开 -->
        <ui:NavigationViewItem x:Name="GrpOps" Content="运维" Tag=""
                               IsExpanded="True" IsMenuElement="True"
                               FontWeight="Bold"
                               Icon="{ui:SymbolIcon Wrench24}">
          <ui:NavigationViewItem.MenuItems>
            <ui:NavigationViewItem Content="安装" Tag="install" Click="NavItem_Click" FontWeight="SemiBold"
                                   Icon="{ui:SymbolIcon ArrowDownload24}" />
            <ui:NavigationViewItem Content="卸载" Tag="uninstall" Click="NavItem_Click" FontWeight="SemiBold"
                                   Icon="{ui:SymbolIcon Delete24}" />
            <ui:NavigationViewItem Content="诊断" Tag="diagnose" Click="NavItem_Click" FontWeight="SemiBold"
                                   Icon="{ui:SymbolIcon HeartPulse24}" />
          </ui:NavigationViewItem.MenuItems>
        </ui:NavigationViewItem>

        <ui:NavigationViewItem x:Name="GrpFlow" Content="优选流程" Tag=""
                               IsExpanded="True" IsMenuElement="True"
                               FontWeight="Bold"
                               Icon="{ui:SymbolIcon Filter24}">
          <ui:NavigationViewItem.MenuItems>
            <ui:NavigationViewItem Content="全量扫描" Tag="scan" Click="NavItem_Click" FontWeight="SemiBold"
                                   Icon="{ui:SymbolIcon Gauge24}" />
            <ui:NavigationViewItem Content="延迟实测" Tag="latency" Click="NavItem_Click" FontWeight="SemiBold"
                                   Icon="{ui:SymbolIcon Clock24}" />
            <ui:NavigationViewItem Content="下载测速" Tag="speedtest" Click="NavItem_Click" FontWeight="SemiBold"
                                   Icon="{ui:SymbolIcon CloudArrowDown24}" />
            <ui:NavigationViewItem Content="清单选用" Tag="picker" Click="NavItem_Click" FontWeight="SemiBold"
                                   Icon="{ui:SymbolIcon CheckmarkCircle24}" />
          </ui:NavigationViewItem.MenuItems>
        </ui:NavigationViewItem>

        <!-- 内核与代理：放在主导航里（不是弹窗）。点一下右边就换页。 -->
        <ui:NavigationViewItem x:Name="GrpKernel" Content="内核与代理" Tag=""
                               IsExpanded="True" IsMenuElement="True"
                               FontWeight="Bold"
                               Icon="{ui:SymbolIcon DeveloperBoard24}">
          <ui:NavigationViewItem.MenuItems>
            <ui:NavigationViewItem Content="内核" Tag="drivers" Click="NavItem_Click" FontWeight="SemiBold"
                                   Icon="{ui:SymbolIcon Power24}" />
            <ui:NavigationViewItem Content="订阅" Tag="sub" Click="NavItem_Click" FontWeight="SemiBold"
                                   Icon="{ui:SymbolIcon CloudArrowDown24}" />
            <ui:NavigationViewItem Content="节点" Tag="nodes" Click="NavItem_Click" FontWeight="SemiBold"
                                   Icon="{ui:SymbolIcon Globe24}" />
            <ui:NavigationViewItem Content="Ping" Tag="trace" Click="NavItem_Click" FontWeight="SemiBold"
                                   Icon="{ui:SymbolIcon Pulse24}" />
          </ui:NavigationViewItem.MenuItems>
        </ui:NavigationViewItem>
      </ui:NavigationView.MenuItems>

      <ui:NavigationView.FooterMenuItems>
        <ui:NavigationViewItem Content="清理缓存" Tag="cache" Click="NavItem_Click" FontWeight="SemiBold"
                               Icon="{ui:SymbolIcon Broom24}" />
        <ui:NavigationViewItem Content="自动优选·标准" Tag="autostd" Click="NavItem_Click" FontWeight="SemiBold"
                               Icon="{ui:SymbolIcon ArrowSync24}" />
        <ui:NavigationViewItem Content="自动优选·快速" Tag="autofast" Click="NavItem_Click" FontWeight="SemiBold"
                               Icon="{ui:SymbolIcon Flash24}" />
        <ui:NavigationViewItem Content="设置" Tag="settings" Click="NavItem_Click" FontWeight="SemiBold"
                               Icon="{ui:SymbolIcon Settings24}" />
      </ui:NavigationView.FooterMenuItems>

      <!-- ==================== 内容区 ==================== -->
      <ui:NavigationView.ContentOverlay>
        <Grid Margin="26,10,26,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="RowDrawers" Height="*" />
            <!-- 弹性空白：两个抽屉都收起时由这一行吃掉剩余高度，
                 这样底部按钮和进度条依旧钉在底部，不会留一片空 -->
            <RowDefinition x:Name="RowSlack" Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- 0 标题 + 恢复教程按钮 -->
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock Grid.Column="0" x:Name="TxtTitle" FontTypography="Title"
                          FontWeight="Bold" Text="一键完成" VerticalAlignment="Center" />
            <ui:InfoBadge Grid.Column="1" x:Name="BadgeAdmin" Margin="14,0,0,0"
                          VerticalAlignment="Center" Severity="Informational"
                          Value="需要管理员权限" />
            <ui:Button Grid.Column="2" x:Name="BtnHelp" HorizontalAlignment="Right"
                       Appearance="Transparent" Icon="{ui:SymbolIcon QuestionCircle24}"
                       Content="说明" ToolTip="显示 / 隐藏这一步的说明"
                       Visibility="Collapsed" Click="BtnHelp_Click" />
          </Grid>

          <!-- 1 说明卡（右上角有关闭按钮） -->
          <ui:Card x:Name="CardDesc" Grid.Row="1" Margin="0,14,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0" FontTypography="BodyStrong"
                              Text="这一步会做什么" VerticalAlignment="Center"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:Button Grid.Column="1" x:Name="BtnCloseDesc" Appearance="Transparent"
                           Icon="{ui:SymbolIcon Dismiss24}" ToolTip="关闭说明"
                           Click="BtnCloseDesc_Click" />
              </Grid>

              <ui:TextBlock Grid.Row="1" x:Name="TxtDesc" FontTypography="Body"
                            Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="19"
                            LineStackingStrategy="BlockLineHeight"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="从零到能用，一条龙全自动。" />
            </Grid>
          </ui:Card>

          <!-- 2 缓存勾选 -->
          <ui:Card x:Name="CardCache" Grid.Row="2" Margin="0,12,0,0" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ScrollViewer Grid.Column="0" MaxHeight="200" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CacheList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" Margin="0,3"
                                VerticalContentAlignment="Center">
                        <StackPanel Margin="8,0,0,0">
                          <ui:TextBlock FontTypography="Body" Text="{Binding Text}"
                                        FontFamily="Consolas,Microsoft YaHei UI" />
                          <ui:TextBlock FontTypography="Caption" LineHeight="16" Text="{Binding Sub}"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                      </CheckBox>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                <ui:Button x:Name="BtnSelAll" Content="全选" Click="BtnSelAll_Click" />
                <ui:Button x:Name="BtnSelNone" Content="全不选" Margin="0,8,0,0"
                           Click="BtnSelNone_Click" />
              </StackPanel>
            </Grid>
          </ui:Card>

          <!-- 2b 设置（和「缓存勾选」共用第 2 行，两者互斥显示）
               以前主题切换是个「导航项」，和功能项并排放在侧栏底部，语义不对 ——
               它不是一个"要去的地方"，而是一个开关。收进这里。
               注意：这一页排成两栏，高度压到 ~230px —— 单栏竖排会把下面两个抽屉挤没。 -->
          <ui:Card x:Name="CardSettings" Grid.Row="2" Margin="0,12,0,0" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Margin="0,0,22,0">
                <ui:TextBlock FontTypography="BodyStrong" Text="外观"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <RadioButton x:Name="RbThemeSystem" GroupName="themeChoice" Content="跟随系统（推荐）"
                             Margin="0,8,0,0" Checked="ThemeChoice_Checked" />
                <RadioButton x:Name="RbThemeLight" GroupName="themeChoice" Content="浅色"
                             Margin="0,6,0,0" Checked="ThemeChoice_Checked" />
                <RadioButton x:Name="RbThemeDark" GroupName="themeChoice" Content="深色"
                             Margin="0,6,0,0" Checked="ThemeChoice_Checked" />

                <Border Height="1" Margin="0,12,0,10"
                        Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                <ui:TextBlock FontTypography="BodyStrong" Text="窗口"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <CheckBox x:Name="CkRememberWindow" Content="记住窗口大小和位置"
                          Margin="0,8,0,0" Click="CkRememberWindow_Click" />
                <CheckBox x:Name="CkTray" Content="最小化时缩到托盘"
                          Margin="0,6,0,0" Click="CkTray_Click" />

                <Border Height="1" Margin="0,12,0,10"
                        Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                <ui:TextBlock FontTypography="BodyStrong" Text="界面缩放"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <RadioButton x:Name="RbScaleS" GroupName="scaleChoice" Content="80%"
                               Checked="ScaleChoice_Checked" />
                  <RadioButton x:Name="RbScaleM" GroupName="scaleChoice" Content="90%"
                               Margin="16,0,0,0" Checked="ScaleChoice_Checked" />
                  <RadioButton x:Name="RbScaleL" GroupName="scaleChoice" Content="100%"
                               Margin="16,0,0,0" Checked="ScaleChoice_Checked" />
                </StackPanel>
                <ui:TextBlock Margin="0,6,0,0" FontTypography="Caption"
                              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                              TextWrapping="Wrap"
                              Text="字体和窗口一起缩放。系统缩放调得高（125%/150%）时选小一档，窗口和字都会跟着变小。" />
              </StackPanel>

              <StackPanel Grid.Column="1">
                <ui:TextBlock FontTypography="BodyStrong" Text="数据与排障"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:Button x:Name="BtnDiag" Content="导出诊断包" Appearance="Primary"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                           Margin="0,8,0,0"
                           Icon="{ui:SymbolIcon DocumentBulletList24}" Click="BtnDiag_Click" />
                <ui:Button x:Name="BtnOpenData" Content="打开数据目录"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                           Margin="0,6,0,0"
                           Icon="{ui:SymbolIcon FolderOpen24}" Click="BtnOpenData_Click" />
                <ui:Button x:Name="BtnResetUi" Content="重置界面状态"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                           Margin="0,6,0,0" Click="BtnResetUi_Click" />
                <!-- 内核（winws / mihomo）管理与 trace 都在这个窗口里 -->
                <!-- 破坏性操作：停止加速服务。停完想恢复必须重启电脑（WinDivert 驱动限制），
                     所以文案和样式都要足够刺眼，别让人误点。 -->
                <ui:Button x:Name="BtnStopSvc" Content="关闭加速服务（需重启恢复）"
                           Appearance="Danger"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                           Margin="0,6,0,0" Click="BtnStopSvc_Click" />
              </StackPanel>
            </Grid>
          </ui:Card>


          <!-- ==================== 应用更新（设置页同屏显示） ==================== -->
          <ui:Card x:Name="CardUpdate" Grid.Row="2" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="应用更新" />
              <ui:TextBlock Margin="0,4,0,0" FontTypography="Caption" TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="从 GitHub 私有仓库的 Release 检查新版本；下载后校验 SHA256 再启动安装程序。" />

              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0" Text="当前版本" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ui:TextBlock x:Name="TxtAppVersion" Grid.Column="1" VerticalAlignment="Center"
                              FontTypography="BodyStrong" Text="—" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                  <ui:Button x:Name="BtnCheckUpdate" Content="检查更新" Width="100" Height="32"
                             Click="BtnCheckUpdate_Click" />
                  <ui:Button x:Name="BtnDoSUpdate" Content="下载并安装" Width="120" Height="32" Margin="8,0,0,0"
                             Appearance="Primary" IsEnabled="False" Click="BtnDoUpdate_Click" />
                </StackPanel>
              </Grid>

              <ProgressBar x:Name="BarUpdate" Height="6" Margin="0,10,0,0" Minimum="0" Maximum="100"
                           Value="0" Visibility="Collapsed" />

              <ui:TextBlock x:Name="TxtUpdateStatus" Margin="0,8,0,0" FontTypography="Caption" TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="" />
              <TextBox x:Name="TxtUpdateNotes" Margin="0,8,0,0" Height="120" IsReadOnly="True"
                       TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"
                       FontFamily="Consolas" FontSize="12" />
            </StackPanel>
          </ui:Card>
          <!-- ==================== 内核（winws / mihomo）导航页 ==================== -->
          <ui:Card x:Name="CardDrivers" Grid.Row="2" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="8" Padding="12"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                  <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="winws（DPI 伪装）" />
                    <ui:TextBlock x:Name="TxtWinwsVersion" Margin="0,6,0,0" FontTypography="Caption"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="版本：—" />
                    <ui:TextBlock x:Name="TxtWinwsStatus" Margin="0,2,0,0" Text="状态：已停止" />
                    <WrapPanel Margin="0,10,0,0">
                      <ui:Button x:Name="BtnWinwsStart" Content="开启" Width="72" Margin="0,0,6,6" Click="BtnWinwsStart_Click" />
                      <ui:Button x:Name="BtnWinwsStop" Content="关闭" Width="72" Margin="0,0,6,6" Click="BtnWinwsStop_Click" />
                      <ui:Button x:Name="BtnWinwsRestart" Content="重启" Width="72" Margin="0,0,6,6" Click="BtnWinwsRestart_Click" />
                      <ui:Button x:Name="BtnWinwsUpdate" Content="更新内核" Width="90" Margin="0,0,0,6" Click="BtnWinwsUpdate_Click" />
                    </WrapPanel>
                  </StackPanel>
                </Border>

                <Border Grid.Column="2" CornerRadius="8" Padding="12"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                  <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="mihomo（代理内核）" />
                    <ui:TextBlock x:Name="TxtMihomoVersion" Margin="0,6,0,0" FontTypography="Caption"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="版本：—" />
                    <ui:TextBlock x:Name="TxtMihomoStatus" Margin="0,2,0,0" Text="状态：已停止" />
                    <WrapPanel Margin="0,10,0,0">
                      <ui:Button x:Name="BtnMihomoStart" Content="开启" Width="72" Margin="0,0,6,6" Click="BtnMihomoStart_Click" />
                      <ui:Button x:Name="BtnMihomoStop" Content="关闭" Width="72" Margin="0,0,6,6" Click="BtnMihomoStop_Click" />
                      <ui:Button x:Name="BtnMihomoRestart" Content="重启" Width="72" Margin="0,0,6,6" Click="BtnMihomoRestart_Click" />
                      <ui:Button x:Name="BtnMihomoUpdate" Content="更新内核" Width="90" Margin="0,0,0,6" Click="BtnMihomoUpdate_Click" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </Grid>

              <ui:TextBlock Margin="0,10,0,0" FontTypography="Caption" TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="两个内核互相独立，各自开启 / 关闭 / 重启。winws 与 mihomo 的 TUN 不能同时开启：TUN 会接管整包，和 winws 的伪装叠加会互相破坏。" />

              <WrapPanel Margin="0,10,0,0">
                <ui:Button x:Name="BtnKernelDiag" Content="一键诊断" Width="96" Height="30" Margin="0,0,8,0" Click="BtnKernelDiag_Click" />
                <ui:Button x:Name="BtnKernelMigrate" Content="迁移旧服务" Width="110" Height="30" Margin="0,0,8,0" Click="BtnKernelMigrate_Click" />
                <ui:Button x:Name="BtnKernelLog" Content="打开内核日志" Width="120" Height="30" Margin="0,0,8,0" Click="BtnKernelLog_Click" />
                <ui:Button x:Name="BtnKernelRefresh" Content="刷新状态" Width="96" Height="30" Click="BtnKernelRefresh_Click" />
              </WrapPanel>

              <CheckBox x:Name="ChkAutoStart" Content="开机自动启动本程序（缩到托盘）" Margin="0,12,0,0" Checked="ChkAutoStart_Changed" Unchecked="ChkAutoStart_Changed" />
              <CheckBox x:Name="ChkAutoStartDrivers" Content="程序启动时自动开启上次用的内核" Margin="0,8,0,0" Checked="ChkAutoStartDrivers_Changed" Unchecked="ChkAutoStartDrivers_Changed" />
              <ui:TextBlock Margin="0,6,0,0" FontTypography="Caption" TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="第二个选项默认关闭：没勾选时，打开本程序不会自动拉起任何内核。" />
            </StackPanel>
          </ui:Card>
          <!-- ==================== 订阅（mihomo）导航页 ==================== -->
          <ui:Card x:Name="CardSub" Grid.Row="2" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="订阅" />
              <ui:TextBlock Margin="0,4,0,0" FontTypography="Caption" TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="填 Clash 格式的订阅地址，点「导入 / 更新」会自动下载节点。下载后下面会列出订阅里的代理组。" />

              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="TxtSubscription" Grid.Column="0" Height="32" VerticalContentAlignment="Center" />
                <ui:Button x:Name="BtnSaveSub" Grid.Column="1" Content="导入 / 更新" Width="120" Height="32"
                           Margin="8,0,0,0" Appearance="Primary" Click="BtnSaveSub_Click" />
              </Grid>

              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="220" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0" Text="订阅组" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="CmbGroup" Grid.Column="1" Height="32" SelectionChanged="CmbGroup_SelectionChanged" />
                <ui:TextBlock x:Name="TxtSubInfo" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                              FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="（尚未导入）" />
              </Grid>

              <WrapPanel Margin="0,12,0,0">
                <ui:Button x:Name="BtnSubRestart" Content="重启 mihomo 使其生效" Width="170" Height="30" Margin="0,0,8,0" Click="BtnSubRestart_Click" />
                <ui:Button x:Name="BtnSubOpenDir" Content="打开订阅目录" Width="120" Height="30" Click="BtnSubOpenDir_Click" />
              </WrapPanel>
            </StackPanel>
          </ui:Card>

          <!-- ==================== 节点导航页 ==================== -->
          <ui:Card x:Name="CardNodes" Grid.Row="2" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="节点" />
              <ui:TextBlock Margin="0,4,0,0" FontTypography="Caption" TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="从「订阅」页选中的组里挑一个节点。换节点即时生效，不用重启 mihomo。" />

              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0" x:Name="TxtNodeHint" VerticalAlignment="Center"
                              FontTypography="Caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                              Text="节点列表为空 —— 先到「订阅」页导入，或到「内核」页开启 mihomo。" />
                <ui:Button x:Name="BtnProbeNodes" Grid.Column="1" Content="测全部延迟" Width="110" Height="30"
                           Click="BtnProbeNodes_Click" />
              </Grid>

              <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                <ItemsControl x:Name="NodeList">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Tag="{Binding Name}" Click="NodeTile_Click" Width="214" Height="58"
                              AutomationProperties.Name="{Binding Name}"
                              Margin="0,0,8,8" Padding="10,6" HorizontalContentAlignment="Stretch"
                              Background="{Binding Bg}" BorderBrush="{Binding Border}" BorderThickness="1">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" />
                            <TextBlock Text="{Binding Sub}" FontSize="10" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding LatText}" VerticalAlignment="Center"
                                     FontSize="12" Margin="6,0,0,0" Foreground="{Binding LatBrush}" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0" Text="代理模式" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="CmbMode" Grid.Column="1" Height="32">
                  <ComboBoxItem Content="规则（推荐）" Tag="rule" IsSelected="True" />
                  <ComboBoxItem Content="全局" Tag="global" />
                  <ComboBoxItem Content="直连" Tag="direct" />
                </ComboBox>
                <ui:Button x:Name="BtnApplyMode" Grid.Column="2" Content="应用模式" Width="96" Height="32" Margin="12,0,0,0" Click="BtnApplyMode_Click" />
                <CheckBox x:Name="ChkTun" Grid.Column="3" Content="TUN 模式" VerticalAlignment="Center" Margin="16,0,0,0" Checked="ChkTun_Changed" Unchecked="ChkTun_Changed" />
                <ui:TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="8,0,0,0" FontTypography="Caption"
                              Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="改完需重启 mihomo" />
              </Grid>

              <ui:TextBlock Margin="0,8,0,0" FontTypography="Caption" TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="TUN 关闭时：只有 Photon 游戏网段走代理，其它直连（下载满速）。TUN 开启时：全部流量走代理，但会和 winws 冲突。" />
            </StackPanel>
          </ui:Card>
          <!-- ==================== Trace 导航页 ==================== -->
          <ui:Card x:Name="CardTrace" Grid.Row="2" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel>
              <ui:TextBlock FontTypography="BodyStrong" Text="Ping（经节点）" />
              <ui:TextBlock Margin="0,4,0,0" FontTypography="Caption" TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="对下面填的 IP/域名，经每个节点做一次 TCP+TLS 握手（443 端口），量真实往返。ICMP 不能走代理（内核一律 DIRECT），所以这里用 TLS 握手等效「ping」。直连不通的 IP 也能测出各节点差异。" />

              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="60" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBlock Grid.Column="0" Text="目标" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ui:TextBox x:Name="TxtTraceTarget" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Text="www.gstatic.com" />
                <ui:TextBlock Grid.Column="2" Text="每节点次数" VerticalAlignment="Center" Margin="12,0,8,0" />
                <ui:TextBox x:Name="TxtTraceTries" Grid.Column="3" Height="32" VerticalContentAlignment="Center" Text="3" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="12,0,0,0">
                  <ui:Button x:Name="BtnTraceStart" Content="开始 Ping" Width="110" Height="32" Appearance="Primary" Click="BtnTraceStart_Click" />
                  <ui:Button x:Name="BtnTraceStop" Content="停止" Width="64" Height="32" Margin="8,0,0,0"
                             IsEnabled="False" Click="BtnTraceStop_Click" />
                </StackPanel>
              </Grid>

              <DataGrid x:Name="GridTrace" Height="240" Margin="0,10,0,0" AutoGenerateColumns="False"
                        IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="节点" Binding="{Binding Node}" Width="200" />
                  <DataGridTextColumn Header="最小" Binding="{Binding MinText}" Width="62" />
                  <DataGridTextColumn Header="平均" Binding="{Binding AvgText}" Width="62" />
                  <DataGridTextColumn Header="丢包" Binding="{Binding LossText}" Width="54" />
                </DataGrid.Columns>
              </DataGrid>

              <ui:TextBlock x:Name="TxtTraceStatus" Margin="0,8,0,0" FontTypography="Caption"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
          </ui:Card>
          <!-- 设置页的路径信息。放第 3 行：那一行是操作按钮，设置页会把按钮整排收掉，
               所以这里只有设置页能看到它，不会和别的内容挤在一起。 -->
          <ui:TextBlock x:Name="TxtSettingsInfo" Grid.Row="3" Margin="2,12,2,0"
                        TextWrapping="Wrap" FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Visibility="Collapsed" />

          <!-- 3 操作按钮 -->
          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
            <ui:Button x:Name="BtnRun" Appearance="Primary"
                       Icon="{ui:SymbolIcon Play24}" Content="开始执行"
                       Click="BtnRun_Click" />
            <ui:Button x:Name="BtnStop" Appearance="Danger" Margin="10,0,0,0"
                       IsEnabled="False"
                       Icon="{ui:SymbolIcon Stop24}" Content="停止"
                       Click="BtnStop_Click" />
            <!-- IsIndeterminate=True 才会持续转。
                 默认（false）时按 Value 画一个静态圆弧 —— 看起来就是「卡住不动的圈」。
                 另外 Visibility 从 Collapsed 变回 Visible 时动画不一定重启，
                 所以 SetBusy 里会再手动重触发一次。 -->
            <ui:ProgressRing x:Name="Ring" Width="20" Height="20" Margin="14,0,0,0"
                             IsIndeterminate="True"
                             VerticalAlignment="Center" Visibility="Collapsed" />
          </StackPanel>

          <!-- 4 可收起的抽屉：运行日志 / 实时 IP 结果 -->
          <Grid Grid.Row="4" Margin="0,18,0,0">
            <Grid.RowDefinitions>
              <RowDefinition x:Name="RowLog" />
              <RowDefinition Height="Auto" />
              <RowDefinition x:Name="RowIp" />
            </Grid.RowDefinitions>

            <ui:CardExpander x:Name="ExpLog" Grid.Row="0" VerticalAlignment="Stretch" Header="运行日志" FontWeight="Bold"
                             IsExpanded="True" Icon="{ui:SymbolIcon TextBulletListSquare24}">
              <!-- 包一层：CardExpander 收起时不会把内容从测量中排除，
                   所以由 LayoutDrawers 显式切换这层的 Visibility，
                   DesiredSize 才会真正缩到只剩标题栏 -->
              <Grid x:Name="LogBody">
                <!-- 用 RichTextBox 而不是 TextBox：日志要按 [ok]/[!]/[x] 前缀着色。
                     脚本本来就在行首打了这些标记，但输出被重定向后 ANSI 颜色没了，
                     这里在 C# 侧按前缀补回来。代价是比 TextBox 重，所以 Append 配了环形缓冲。 -->
                <RichTextBox x:Name="TxtLog" IsReadOnly="True" BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             FontFamily="Consolas,Microsoft YaHei UI"
                             VerticalScrollBarVisibility="Auto"
                             IsDocumentEnabled="True" Padding="4,2" />
              </Grid>
            </ui:CardExpander>

            <!-- 之前这里只有一个 Background="Transparent" 的 GridSplitter —— 完全看不见，
                 用户根本不知道能拖。加一条细线 + 中间一个胶囊抓手，整体仍然全透明可拖。 -->
            <Grid x:Name="SplHost" Grid.Row="1" Height="12" Background="Transparent">
              <Border Height="1" VerticalAlignment="Center"
                      Background="{DynamicResource CardStrokeColorDefaultBrush}" />
              <Border Width="36" Height="4" CornerRadius="2" Opacity="0.5"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Background="{DynamicResource TextFillColorTertiaryBrush}" />
              <GridSplitter x:Name="SplMain" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Background="Transparent" ResizeBehavior="PreviousAndNext" />
            </Grid>

            <ui:CardExpander x:Name="ExpIp" Grid.Row="2" VerticalAlignment="Stretch" IsExpanded="True"
                             Icon="{ui:SymbolIcon DataUsage24}">
              <ui:CardExpander.Header>
                <DockPanel>
                  <ui:TextBlock DockPanel.Dock="Right" x:Name="TxtIpCount"
                                FontTypography="Caption" VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                  <ui:TextBlock Text="实时 IP 结果" VerticalAlignment="Center" />
                </DockPanel>
              </ui:CardExpander.Header>

              <Grid x:Name="IpBody">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <!-- 过滤框：一次实测能出几十行，纯靠滚太累 -->
              <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <ui:TextBlock DockPanel.Dock="Right" x:Name="TxtFilterCount"
                              FontTypography="Caption" VerticalAlignment="Center" Margin="10,0,0,0"
                              Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <ui:TextBox x:Name="TxtFilter" Height="32" ClearButtonEnabled="True"
                            PlaceholderText="过滤 IP 或说明，例如：104.  /  失败  /  抖动"
                            TextChanged="TxtFilter_TextChanged">
                  <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                  </ui:TextBox.Icon>
                </ui:TextBox>
              </DockPanel>

              <Grid Grid.Row="1">
              <DataGrid x:Name="GridIp" AutoGenerateColumns="False" IsReadOnly="True"
                        EnableRowVirtualization="True" EnableColumnVirtualization="True"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                        BorderThickness="0" Background="Transparent"
                        CanUserAddRows="False" CanUserResizeRows="False"
                        CanUserReorderColumns="False" CanUserSortColumns="False"
                        SelectionMode="Single" SelectionUnit="FullRow"
                        FontFamily="Consolas,Microsoft YaHei UI">
                <DataGrid.RowStyle>
                  <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="{Binding Fg}" />
                    <Setter Property="ToolTip" Value="{Binding Note}" />
                  </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="组" Binding="{Binding Group}" Width="56" />
                  <DataGridTextColumn Header="IP 地址" Binding="{Binding Ip}" Width="190" />
                  <DataGridTextColumn Header="本次延迟" Binding="{Binding Lat}" Width="118" />
                  <DataGridTextColumn Header="成功/总" Binding="{Binding OkTot}" Width="96" />
                  <DataGridTextColumn Header="中位" Binding="{Binding Med}" Width="96" />
                  <DataGridTextColumn Header="抖动" Binding="{Binding Jit}" Width="96" />
                  <DataGridTextColumn Header="说明" Binding="{Binding Note}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>

              <!-- 空状态：没数据 / 过滤后没匹配。
                   用 Top + 42 的偏移绕开 DataGrid 的表头行（表头约 40px 高）。 -->
              <ui:TextBlock x:Name="TxtEmptyIp" Margin="0,42,8,0"
                            VerticalAlignment="Top" HorizontalAlignment="Left"
                            IsHitTestVisible="False"
                            FontTypography="Body" TextWrapping="Wrap" LineHeight="22"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="执行后会逐个显示候选 IP 的延迟、成功率和抖动。" />
              </Grid>
              </Grid>
            </ui:CardExpander>
          </Grid>

          <!-- 5 底部按钮 -->
          <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,14,0,0">
            <ui:Button x:Name="BtnClear" Icon="{ui:SymbolIcon Broom24}"
                       Content="清空日志" Click="BtnClear_Click" />
            <ui:Button x:Name="BtnCopyLog" Icon="{ui:SymbolIcon Copy24}"
                       Content="复制日志" Margin="8,0,0,0" Click="BtnCopyLog_Click" />
            <ui:Button x:Name="BtnOpenDir" Icon="{ui:SymbolIcon FolderOpen24}"
                       Content="程序目录" ToolTip="打开程序所在目录（缓存数据在它下面的 data 里）"
                       Margin="8,0,0,0" Click="BtnOpenDir_Click" />
            <ui:ToggleSwitch x:Name="SwAutoScroll" Content="自动滚动" IsChecked="True"
                             Margin="16,0,0,0" VerticalAlignment="Center"
                             Click="SwAutoScroll_Click" />
            <ui:TextBlock x:Name="TxtScriptDir" FontTypography="Caption" Margin="16,0,0,0"
                          VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                          Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          </StackPanel>

          <!-- 6 进度条（最底部） -->
          <Grid x:Name="ProgBox" Grid.Row="7" Margin="0,14,0,16" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,6">
              <ui:TextBlock DockPanel.Dock="Right" x:Name="TxtProgPct" FontTypography="Caption"
                            FontFamily="Consolas,Microsoft YaHei UI"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="0%" />
              <ui:TextBlock x:Name="TxtProgStep" FontTypography="BodyStrong"
                            TextTrimming="CharacterEllipsis" Text="准备中" />
            </DockPanel>
            <!-- 默认 indeterminate：大多数脚本（诊断、清理缓存、延迟实测的第一段）
                 根本不吐 ##PROG##，条子会永远停在 0% 看着像坏了。
                 收到第一个 ##PROG## 后再切成确定值。 -->
            <ProgressBar x:Name="BarProg" Grid.Row="1" Minimum="0" Maximum="100" Value="0"
                         IsIndeterminate="True" />
          </Grid>
        </Grid>
      </ui:NavigationView.ContentOverlay>
    </ui:NavigationView>
  </Grid>
</ui:FluentWindow>
